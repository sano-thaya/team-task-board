@TeamTaskBoard.Api_HostAddress = http://localhost:5159

GET {{TeamTaskBoard.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

# Set this to a Firebase ID token for the authenticated requests below.
@firebaseIdToken = replace-with-firebase-id-token

### Verify a missing token (expected 401)
GET {{TeamTaskBoard.Api_HostAddress}}/api/auth/verify

### Verify a Firebase ID token (expected 200 for a valid token)
GET {{TeamTaskBoard.Api_HostAddress}}/api/auth/verify
Authorization: Bearer {{firebaseIdToken}}

### Synchronize a profile (expected 200; repeat safely to verify idempotency)
POST {{TeamTaskBoard.Api_HostAddress}}/api/auth/sync
Authorization: Bearer {{firebaseIdToken}}
Content-Type: application/json

{
  "displayName": "Example User"
}

### Get the authenticated profile (expected 200)
GET {{TeamTaskBoard.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{firebaseIdToken}}

### List projects available to the authenticated user
GET {{TeamTaskBoard.Api_HostAddress}}/api/projects
Authorization: Bearer {{firebaseIdToken}}

### Create a project; member emails must belong to synchronized users
POST {{TeamTaskBoard.Api_HostAddress}}/api/projects
Authorization: Bearer {{firebaseIdToken}}
Content-Type: application/json

{
  "name": "Website redesign",
  "description": "Plan the next website release.",
  "memberEmails": []
}

### Get, update, or delete a project by ID
@projectId = 1
GET {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}
Authorization: Bearer {{firebaseIdToken}}

###
PUT {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}
Authorization: Bearer {{firebaseIdToken}}
Content-Type: application/json

{
  "name": "Updated website redesign",
  "description": "Updated project scope.",
  "memberEmails": []
}

###
DELETE {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}
Authorization: Bearer {{firebaseIdToken}}

### List tasks, optionally using search and priority filtering
GET {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/tasks?search=login&priority=High&status=InProgress&page=1&pageSize=25
Authorization: Bearer {{firebaseIdToken}}

### Create a task; assignedUserId must be the owner or a project member
POST {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/tasks
Authorization: Bearer {{firebaseIdToken}}
Content-Type: application/json

{
  "title": "Fix login validation",
  "description": "Add coverage for expired tokens.",
  "assignedUserId": 1,
  "priority": "High",
  "status": "ToDo",
  "dueDateUtc": "2026-12-01T23:59:59Z"
}

### Get, update, or delete a task by ID
@taskId = 1
GET {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/tasks/{{taskId}}
Authorization: Bearer {{firebaseIdToken}}

###
PUT {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/tasks/{{taskId}}
Authorization: Bearer {{firebaseIdToken}}
Content-Type: application/json

{
  "title": "Fix login validation",
  "description": "Completed token validation work.",
  "assignedUserId": 1,
  "priority": "High",
  "status": "Completed",
  "dueDateUtc": "2026-12-01T23:59:59Z"
}

###
DELETE {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/tasks/{{taskId}}
Authorization: Bearer {{firebaseIdToken}}

### Assignment-compatible task routes
GET {{TeamTaskBoard.Api_HostAddress}}/api/tasks/{{taskId}}
Authorization: Bearer {{firebaseIdToken}}

###
PUT {{TeamTaskBoard.Api_HostAddress}}/api/tasks/{{taskId}}
Authorization: Bearer {{firebaseIdToken}}
Content-Type: application/json

{
  "title": "Updated task",
  "description": "Updated through the compatibility route.",
  "assignedUserId": 1,
  "priority": "Medium",
  "status": "InProgress",
  "dueDateUtc": "2026-12-01T23:59:59Z"
}

###
DELETE {{TeamTaskBoard.Api_HostAddress}}/api/tasks/{{taskId}}
Authorization: Bearer {{firebaseIdToken}}

### List comments for a task
GET {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/tasks/{{taskId}}/comments
Authorization: Bearer {{firebaseIdToken}}

### Create a top-level comment
POST {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/tasks/{{taskId}}/comments
Authorization: Bearer {{firebaseIdToken}}
Content-Type: application/json

{
  "text": "Please review this task."
}

### Reply to a comment by its Firestore document ID
POST {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/tasks/{{taskId}}/comments
Authorization: Bearer {{firebaseIdToken}}
Content-Type: application/json

{
  "text": "I will review it today.",
  "parentCommentId": "replace-with-comment-document-id"
}

### Owner-only overdue report
GET {{TeamTaskBoard.Api_HostAddress}}/api/projects/{{projectId}}/reports/overdue-tasks
Authorization: Bearer {{firebaseIdToken}}
